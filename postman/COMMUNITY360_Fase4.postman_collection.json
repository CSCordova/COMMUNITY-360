{
  "info": {
    "name": "COMMUNITY 360 Fase 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "usuario",
      "value": "isaidemo"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "id_usuario",
      "value": ""
    },
    {
      "key": "id_interaccion_prueba",
      "value": ""
    },
    {
      "key": "version_interaccion",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Comprobar servidor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('access_token', pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar usuarios y elegir un ID válido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/usuarios?limite=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 && pm.response.json().items.length) { pm.collectionVariables.set('id_usuario', pm.response.json().items[0].id_usuario); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar usuario elegido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/usuarios/{{id_usuario}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Analítica histórica del padrón",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/analitica/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Listar interacciones actuales",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/interacciones?limite=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Analítica de interacciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/analitica/interacciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Crear una interacción de demostración",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/interacciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_interaccion\": \"{{id_nuevo}}\",\n  \"id_usuario\": \"{{id_usuario}}\",\n  \"timestamp\": \"{{timestamp_actual}}\",\n  \"canal\": \"Telegram\",\n  \"tipo\": \"mensaje\",\n  \"texto\": \"Interacción de demostración enviada desde Postman.\",\n  \"tema\": \"demostracion\",\n  \"sentimiento\": 0.5,\n  \"idioma\": \"es\",\n  \"dispositivo\": \"Web\",\n  \"reacciones_recibidas\": 0,\n  \"etiquetas\": [\n    \"demostracion\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('id_interaccion_prueba');",
              "pm.collectionVariables.unset('version_interaccion');",
              "pm.variables.set('id_nuevo', 'I9' + String(Math.floor(Math.random() * 1000000)).padStart(6, '0'));",
              "pm.variables.set('timestamp_actual', new Date().toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_interaccion_prueba', pm.response.json().id_interaccion); pm.collectionVariables.set('version_interaccion', pm.response.headers.get('ETag')); }"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar la interacción creada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/interacciones/{{id_interaccion_prueba}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('version_interaccion', pm.response.headers.get('ETag')); }"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Modificar la interacción creada",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "If-Match",
            "value": "{{version_interaccion}}"
          }
        ],
        "url": "{{base_url}}/api/interacciones/{{id_interaccion_prueba}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"texto\": \"Interacción modificada desde Postman.\",\n  \"sentimiento\": -0.25,\n  \"reacciones_recibidas\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('version_interaccion', pm.response.headers.get('ETag')); }"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Volver a consultar la analítica",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/analitica/interacciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Eliminar solo la interacción creada",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "If-Match",
            "value": "{{version_interaccion}}"
          }
        ],
        "url": "{{base_url}}/api/interacciones/{{id_interaccion_prueba}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Confirmar que fue eliminada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/interacciones/{{id_interaccion_prueba}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Cerrar todas las sesiones de la cuenta",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Confirmar JWT revocado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}
