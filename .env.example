# Solo copia como .env si no tienes uno. No sobrescribas tus claves existentes.
TURSO_DRIVER=http
TURSO_DATABASE_URL=libsql://TU-BASE.turso.io
TURSO_AUTH_TOKEN=TU_TOKEN_PRIVADO
FIREBASE_PROJECT_ID=TU_PROJECT_ID
FIRESTORE_DATABASE_ID=(default)
FIREBASE_CREDENTIALS_PATH=credenciales/firebase-service-account.json
# Genera una clave aleatoria privada de al menos 64 caracteres.
JWT_SECRET_KEY=
# En HTTPS usa true; localhost HTTP requiere false.
SESSION_COOKIE_SECURE=false
